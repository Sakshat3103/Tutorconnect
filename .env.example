# Copy this file to .env.local and fill in the values.

# Admin account created when the database is first set up
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Secret used to sign login cookies (any long random string)
AUTH_SECRET=replace-with-a-long-random-string

# Optional: adds an AI-written summary on the AI Match page
# ANTHROPIC_API_KEY=

# Optional: load sample teachers/students/reviews into a NEW database (for demos)
# SEED_DEMO=1
